# =====================================================================
# Feast UI Backend - environment configuration template
# Usage: copy to .env and adjust per environment
#     cp .env.example .env
# Config precedence: shell env vars > backend/.env > built-in defaults
# =====================================================================

# ---------------- HTTP basics ----------------
# Backend listen port
BACKEND_PORT=8001
# Feast REST Registry Server
REGISTRY_URL=http://127.0.0.1:6572
# Feast Online Serving API
ONLINE_URL=http://127.0.0.1:6566
# Allowed CORS origins, comma-separated (* = all)
CORS_ORIGINS=*

# ---------------- AI / LLM ----------------
# LLM chat completions URL
AI_ENDPOINT=https://gaip-api.gaipuat.dev.ali.cloud.cn.hsbc/etiv-ssvc-aigateway-ea-chatcompletion-uat-internal-proxy/v1/api/v1/chat/completions
# Default model
AI_DEFAULT_MODEL=qwen3-LLM
# Selectable models, comma-separated
AI_MODELS=qwen3-LLM
# Value for the request user field
AI_LLM_USER=UC0008739
# Max tool-calling rounds
AI_MAX_TOOL_ROUNDS=5
# max_tokens per answer
AI_MAX_TOKENS=512

# ---------------- DSP authentication ----------------
# DSP token translation endpoint
AI_DSP_TOKEN_URL=https://cmb-ib2b-dsp-pprod-eu.systems.uk.hsbc:8443/dsp/rest-sts/DSP_iB2B/iB2B_tokenTranslator?=&_action=translate
# DSP username
AI_DSP_USERNAME=
# DSP password
AI_DSP_PASSWORD=
